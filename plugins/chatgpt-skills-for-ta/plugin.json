{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chatgpt-skills-for-ta",
  "version": "0.1.0",
  "description": "A pilot recruiting skill by Move: assess the level of a role from its job specification.",
  "author": {
    "name": "Move",
    "url": "https://www.wearemove.com"
  },
  "homepage": "https://www.wearemove.com",
  "keywords": [
    "recruiting",
    "talent-acquisition"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ChatGPT Skills for TA",
        "shortDescription": "Assess role levels and seniority",
        "longDescription": "One-skill pilot by Move. Role Calibrator compares titles, responsibilities and internal pay ladders, then prepares hiring-manager and interview questions.",
        "developerName": "Move",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://www.wearemove.com",
        "brandColor": "#D6C6F4",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "defaultPrompt": [
          "Use role-calibrator to assess the level of this role."
        ]
      }
    }
  },
  "repository": "https://github.com/we-are-move/chatgpt-skills-for-ta"
}
